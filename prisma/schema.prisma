generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  GENERAL
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum ChartSex {
  MALE
  FEMALE
  NOT_APPLICABLE
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String        @id @default(cuid())
  clerkId      String?       @unique
  username     String?       @unique
  passwordHash String?
  role         UserRole      @default(USER)
  email        String        @unique
  profiles     Profile[]
  feedback     Feedback[]
  settings     UserSettings?
  charts       Chart[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model UserSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  defaultChartStyle String   @default("diamond")
  defaultAyanamsa   String   @default("lahiri")
  defaultZodiacMode String   @default("sidereal")
  defaultLanguage   String   @default("en")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Chart {
  id        String   @id @default(cuid())
  userId    String
  name      String?
  dob       DateTime @db.Date
  location  String
  lat       Float
  lon       Float
  notes     String   @default("") @db.Text
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String
  chartName   String?
  fullName    String
  dateOfBirth DateTime @db.Date
  timeOfBirth String
  sex         ChartSex @default(NOT_APPLICABLE)
  latitude    Float
  longitude   Float
  timezone    String
  city        String?
  notes       String   @default("")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, chartName])
  @@index([userId])
}

model Feedback {
  id        String         @id @default(cuid())
  userId    String
  type      FeedbackType
  message   String
  status    FeedbackStatus @default(OPEN)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
